# Copy to .env and fill in. .env is gitignored; never commit real values.

# Neon Postgres connection string. Use a Neon *dev branch* for local work.
# Must be the pooled (-pooler) host in production.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/wedding?sslmode=require

# Shared admin password. Compared in constant time at /admin/login.
ADMIN_PASSWORD=change-me-locally

# HMAC key for the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change-me-to-32-random-bytes-hex

# Absolute origin, no trailing slash.
#
# WARNING: this value is baked into every invitation link sent over WhatsApp.
# A message that has been delivered cannot be reissued, so this MUST be the
# final production domain before the first link goes out.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
