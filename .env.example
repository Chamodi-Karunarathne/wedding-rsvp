# Copy to .env and fill in. .env is gitignored; never commit real values.

# Neon Postgres connection string. Use a Neon *dev branch* for local work.
# Must be the pooled (-pooler) host in production.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/wedding?sslmode=require

# Shared admin password. Compared in constant time at /admin/login.
ADMIN_PASSWORD=change-me-locally

# HMAC key for the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change-me-to-32-random-bytes-hex

# Absolute origin, no trailing slash.
#
# WARNING: this value is baked into every invitation link sent over WhatsApp.
# A message that has been delivered cannot be reissued, so this MUST be the
# final production domain before the first link goes out.
# Also supplies the metadata/preview origin. Set the production HTTPS origin
# before building; NEXT_PUBLIC values are fixed into the build output.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. A single-IP header overwritten by your trusted reverse proxy.
# Leave unset unless direct access to the app is blocked and the ingress
# removes client-supplied values. Never trust an arbitrary X-Forwarded-For chain.
# Without this setting, IP buckets are shared: sign-in 10/15 min, replies 60/min.
# RATE_LIMIT_TRUSTED_IP_HEADER=x-real-ip

# --- Wedding dates -----------------------------------------------------------
#
# Optional. db:prepare uses these to initialize site_config and the event row.
# After initialization, /admin/config changes them. Any ISO 8601 string with
# an offset. A malformed value throws at startup rather than silently
# reverting - a typo in the wedding date is not something to learn from a guest.
#
# One Poruwa ceremony. This initializes events.starts_at, the single source
# of truth for when the wedding is.
WEDDING_EVENT_DATE=2026-12-03T09:15:00+05:30

# The reply date printed on the cards. Displayed on the RSVP form and never
# enforced: late answers are accepted and saved normally.
WEDDING_RSVP_DEADLINE=2026-11-03T23:59:59+05:30

# When venue, time and dress code lead the guest page. Deliberately BEFORE the
# reply date - guests should not be asked to commit before being told where
# they are going.
WEDDING_DETAILS_OPEN_AT=2026-10-01T00:00:00+05:30

# The day-of layout, and the thank-you page after it.
WEDDING_DAY_OF_START_AT=2026-12-03T06:00:00+05:30
WEDDING_THANK_YOU_AT=2026-12-04T00:00:00+05:30
