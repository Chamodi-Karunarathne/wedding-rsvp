{
  "name": "wedding-rsvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-card-assets.ts && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:integration": "node --test scripts/services.integration.test.mjs scripts/prepare.integration.test.mjs src/lib/services/rate-limits.integration.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:prepare": "node --env-file-if-exists=.env src/db/prepare.ts prepare",
    "db:reset-test-data": "node --env-file-if-exists=.env src/db/prepare.ts reset-test-data",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "assets:optimize": "node scripts/optimize-card-assets.ts",
    "card:preview": "node scripts/preview-card.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@neondatabase/serverless": "^1.1.0",
    "@remixicon/react": "^4.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "nanoid": "^6.0.1",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "drizzle-kit": "^0.31.11",
    "pg": "8.23.1",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
